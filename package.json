{
  "name": "@enonic/lib-admin-ui",
  "version": "6.2.0",
  "description": "Admin UI Library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enonic/lib-admin-ui"
  },
  "scripts": {
    "build": "pnpm run build:dev",
    "build:prod": "pnpm run /^build:prod:.*$/",
    "build:prod:js": "tsc -b",
    "build:prod:css": "vite build --mode production",
    "build:dev": "pnpm run /^build:dev:.*$/",
    "build:dev:css": "vite build --mode development",
    "build:dev:js": "tsc -b",
    "check": "pnpm run fix && pnpm run check:types",
    "check:lint": "biome check .",
    "check:types": "tsc -b",
    "fix": "biome check . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@enonic/ui-types": "^0.6.0",
    "dayjs": "^1.11.23",
    "dompurify": "~3.4.17",
    "fine-uploader": "^5.16.2",
    "jquery": "~3.7.1",
    "jquery-simulate": "^1.0.2",
    "jquery-ui": "^1.14.2",
    "mousetrap": "^1.6.5",
    "nanoid": "~6.0.2",
    "nanostores": "~1.5.5",
    "q": "^1.5.1"
  },
  "peerDependencies": {
    "@enonic/input-types": "^0.6.0",
    "@enonic/ui": "^1.5.0",
    "@enonic/ui-utils": "^0.6.0",
    "lucide-react": ">=0.500.0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@enonic/input-types": "^0.6.0",
    "@enonic/ui": "^1.5.0",
    "@enonic/ui-utils": "^0.6.0",
    "@types/jquery": "^3.5.33",
    "@types/jqueryui": "^1.12.24",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "~26.6.5",
    "@types/q": "^1.5.8",
    "autoprefixer": "^10.6.1",
    "browserslist-config-enonic": "^1.0.8",
    "cssnano": "^9.8.0",
    "enonic-admin-artifacts": "^2.5.0",
    "husky": "^9.1.7",
    "jiti": "~2.7.0",
    "less": "^4.9.1",
    "lucide-react": "^1.61.0",
    "postcss-normalize": "^13.0.1",
    "postcss-sort-media-queries": "^6.7.1",
    "preact": "^11.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "browserslist": [
    "extends browserslist-config-enonic"
  ],
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">= 24.15.0",
    "pnpm": ">= 10.33.4"
  }
}
